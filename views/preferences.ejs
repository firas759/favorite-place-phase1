<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <h1 class="mb-4">Cookie Preferences</h1>

    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <div class="card card-body shadow-sm">
      <p>Choose the website theme. Your choice is saved in a browser cookie.</p>
      <form method="POST" action="/preferences">
        <div class="form-check mb-2">
          <input class="form-check-input" type="radio" name="theme" value="light" id="light" <%= theme === 'light' ? 'checked' : '' %>>
          <label class="form-check-label" for="light">Light</label>
        </div>
        <div class="form-check mb-3">
          <input class="form-check-input" type="radio" name="theme" value="dark" id="dark" <%= theme === 'dark' ? 'checked' : '' %>>
          <label class="form-check-label" for="dark">Dark</label>
        </div>
        <button class="btn btn-primary" type="submit">Save Preference</button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
